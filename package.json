{
  "name": "us-county-merge",
  "version": "0.0.0",
  "license": "ISC",
  "description": "Provides an interface that uses US census county data to combine individual US counties into custom regions.",
  "author": "Philip Oriuwa",
  "private": true,
  "type": "module",
  "keywords": [
    "census-data",
    "us-counties",
    "geospatial",
    "custom-regions",
    "data-visualization",
    "population-aggregation",
    "gdp-aggregation",
    "geographic-data",
    "mapping",
    "region-builder"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.json && vite build",
    "build:data": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/build-county-data.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/build-highway-data.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/generate-svg.ts",
    "build:county-data": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/build-county-data.ts",
    "build:highway-data": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/build-highway-data.ts",
    "build:map": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/generate-svg.ts",
    "preview:map": "tsx --tsconfig ./scripts/tsconfig.json --watch ./scripts/generate-svg.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "mapshaper": "^0.6.13",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2"
  }
}
